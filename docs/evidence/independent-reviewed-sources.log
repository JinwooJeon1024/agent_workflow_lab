   1 """Acceptance tests, frozen before the deliberate defect is repaired."""
   2 
   3 import itertools
   4 import json
   5 from pathlib import Path
   6 import subprocess
   7 import sys
   8 import unittest
   9 
  10 from range_summary import coalesce_ranges
  11 
  12 
  13 ROOT = Path(__file__).resolve().parents[1]
  14 
  15 
  16 class CoalesceRangesTests(unittest.TestCase):
  17     def test_empty(self):
  18         self.assertEqual(coalesce_ranges([]), [])
  19 
  20     def test_single(self):
  21         self.assertEqual(coalesce_ranges([7]), [(7, 7)])
  22 
  23     def test_duplicates(self):
  24         self.assertEqual(coalesce_ranges([4, 4, 4]), [(4, 4)])
  25 
  26     def test_consecutive(self):
  27         self.assertEqual(coalesce_ranges([1, 2, 3]), [(1, 3)])
  28 
  29     def test_unsorted_and_duplicates(self):
  30         self.assertEqual(coalesce_ranges([3, 1, 2, 2, 6]), [(1, 3), (6, 6)])
  31 
  32     def test_negative_through_zero(self):
  33         self.assertEqual(coalesce_ranges([0, -2, -1, 4]), [(-2, 0), (4, 4)])
  34 
  35     def test_gaps(self):
  36         self.assertEqual(coalesce_ranges([9, 1, 5]), [(1, 1), (5, 5), (9, 9)])
  37 
  38     def test_arbitrary_size_integers(self):
  39         big = 10**100
  40         self.assertEqual(coalesce_ranges([big + 1, -big, big]),
  41                          [(-big, -big), (big, big + 1)])
  42 
  43     def test_one_shot_iterable(self):
  44         self.assertEqual(coalesce_ranges(iter([4, 2, 3])), [(2, 4)])
  45 
  46     def test_input_not_mutated(self):
  47         values = [3, 1, 2, 2]
  48         before = values.copy()
  49         coalesce_ranges(values)
  50         self.assertEqual(values, before)
  51 
  52     def test_invalid_elements(self):
  53         class IntegerSubclass(int):
  54             pass
  55 
  56         for invalid in (True, False, 1.0, "1", None, [], {}, IntegerSubclass(1)):
  57             with self.subTest(invalid=repr(invalid)):
  58                 with self.assertRaises(TypeError):
  59                     coalesce_ranges([1, invalid, 2])
  60 
  61     def test_exhaustive_small_domain(self):
  62         # 1 + 5 + 25 + 125 + 625 = 781 inputs. Check the contract's invariants
  63         # independently of the grouping implementation.
  64         for length in range(5):
  65             for values in itertools.product(range(-2, 3), repeat=length):
  66                 with self.subTest(values=values):
  67                     ranges = coalesce_ranges(values)
  68                     self.assertEqual(
  69                         [v for start, end in ranges for v in range(start, end + 1)],
  70                         sorted(set(values)),
  71                     )
  72                     self.assertTrue(all(start <= end for start, end in ranges))
  73                     self.assertTrue(all(
  74                         left[1] + 1 < right[0]
  75                         for left, right in zip(ranges, ranges[1:])
  76                     ))
  77 
  78 
  79 class CLITests(unittest.TestCase):
  80     def run_cli(self, *values):
  81         return subprocess.run(
  82             [sys.executable, "-m", "range_summary", *values],
  83             cwd=ROOT, capture_output=True, text=True, timeout=10, check=False,
  84         )
  85 
  86     def test_cli_example(self):
  87         result = self.run_cli("3", "1", "2", "2", "6")
  88         self.assertEqual(result.returncode, 0, result.stderr)
  89         self.assertEqual(result.stdout, "[[1, 3], [6, 6]]\n")
  90         self.assertEqual(result.stderr, "")
  91 
  92     def test_cli_empty(self):
  93         result = self.run_cli()
  94         self.assertEqual(result.returncode, 0, result.stderr)
  95         self.assertEqual(json.loads(result.stdout), [])
  96 
  97     def test_cli_negatives(self):
  98         result = self.run_cli("0", "-2", "-1", "4")
  99         self.assertEqual(result.returncode, 0, result.stderr)
 100         self.assertEqual(json.loads(result.stdout), [[-2, 0], [4, 4]])
 101 
 102     def test_cli_invalid_integer(self):
 103         result = self.run_cli("1", "not-an-integer")
 104         self.assertEqual(result.returncode, 2)
 105         self.assertEqual(result.stdout, "")
 106         self.assertIn("invalid int value", result.stderr)
 107         self.assertNotIn("Traceback", result.stderr)
 108 
 109 
 110 if __name__ == "__main__":
 111     unittest.main()

